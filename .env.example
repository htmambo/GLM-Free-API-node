# ---------------------------------------------------------------------------
# Copy this file to `.env` (which is git-ignored) and fill in the values.
#
#   cp .env.example .env
#
# Then start the bridge with the env file loaded:
#
#   node --env-file=.env main.js
#
# (`npm start` already passes --env-file-if-exists=.env)
# ---------------------------------------------------------------------------

# --- Aliyun captcha credentials (REQUIRED) ---------------------------------
#
# The AccessKey pair used to sign the captcha challenge that every chat
# request carries. Obtain them from the chat.z.ai web client bundle
# (devtools -> Network -> the site's JS chunk that embeds the captcha
# config), or from the upstream Go project this port is based on.
#
# The bridge signs a captcha param on EVERY request, so it refuses to start
# without both values.
ALIYUN_CAPTCHA_ACCESS_KEY_ID=
ALIYUN_CAPTCHA_ACCESS_KEY_SECRET=

# --- Aliyun captcha scene (optional) ----------------------------------------
# Scene identifier. Defaults to the chat.z.ai value when left empty.
ALIYUN_CAPTCHA_SCENE_ID=

# --- Server ------------------------------------------------------------------
# PORT=3001
# HOST=0.0.0.0
# AUTH_TOKEN=Waguri          # CHANGE THIS in production
# TIMEOUT=300000

# --- Upstream ----------------------------------------------------------------
# ZAI_BASE_URL=https://chat.z.ai
# ZAI_REGION=overseas
# ZAI_TOKEN=                  # logged-in user token: raises quota / model access

# --- Agent mode --------------------------------------------------------------
# AGENT_MODE=false
# AGENT_MODE_VARIANT=modern   # modern | legacy
# AGENT_MODE_LEVEL=            # "ultra" enables the ToolParserLLM repair layer

# --- Sessions ----------------------------------------------------------------
# SESSION_POOL_SIZE=5
# SESSION_ACQUIRE_TIMEOUT=10
# SESSION_REUSE_COUNT=10
# SYNC_MODE=false

# --- Network / logging -------------------------------------------------------
# CURL_IMPERSONATE=             # path to a curl-impersonate binary (Chrome TLS fingerprint)
# UPSTREAM_MIN_INTERVAL_MS=     # unset -> random 200-500 ms
# TOKEN_COUNT_TTL_MS=1000
# LOG_LEVEL=debug
# LOG_FORMAT=text
